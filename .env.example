# ProphetGrid environment
# Copy this file to .env and fill in the two values below.

# 0x prefixed private key of the studionet deployer account.
# Never commit the real value. It must never be printed.
GENLAYER_PRIVATE_KEY=

# GitHub personal access token with repo and pages scope.
# Used only by the local publishing scripts.
GITHUB_TOKEN=

# Optional: override the contract address the frontend talks to.
VITE_CONTRACT_ADDRESS=
